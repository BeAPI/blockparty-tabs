#: build/blockparty-tabs-nav-item/index.js:1
msgid "Move tab before"
msgstr "Déplacer l’onglet à gauche"

#: build/blockparty-tabs-nav-item/index.js:1
msgid "Move tab after"
msgstr "Déplacer l’onglet à droite"

#: build/blockparty-tabs-nav-item/index.js:1
