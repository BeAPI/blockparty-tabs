msgid "Settings"
msgstr "Réglages"

#: build/blockparty-tabs-nav/index.js:1
msgid "Label"
msgstr "Libellé"

#: build/blockparty-tabs-nav/index.js:1
msgid ""
"Describe the purpose of this tabbed interface for assistive technologies."
msgstr ""
"Décrivez l'objectif de cette interface à onglets pour les technologies "
"d'assistance."

#: build/blockparty-tabs/index.js:1
msgid "Align top left"
msgstr "Aligner en haut à gauche"

#: build/blockparty-tabs/index.js:1
msgid "Align top center"
msgstr "Aligner en haut au centre"

#: build/blockparty-tabs/index.js:1
msgid "Align top right"
msgstr "Aligner en haut à droite"

#: build/blockparty-tabs/index.js:1
msgid "Align top justified"
msgstr "Aligner en haut justifié"

#: build/blockparty-tabs/index.js:1
msgid "Align sidebar right"
msgstr "Barre latérale à droite"

#: build/blockparty-tabs/index.js:1
msgid "Align sidebar left"
msgstr "Barre latérale à gauche"

#: build/blockparty-tabs-nav-item/block.json
msgctxt "block title"
msgid "Tab"
msgstr "Onglet"

#: build/blockparty-tabs-nav-item/block.json
msgctxt "block description"
msgid "A single tab button used to switch to its matching content panel."
msgstr ""
"Un bouton d'onglet unique servant à basculer vers le panneau de contenu "
"correspondant."

#: build/blockparty-tabs-nav/block.json
msgctxt "block title"
msgid "Tabs list"
msgstr "Liste des onglets"

#: build/blockparty-tabs-nav/block.json
msgctxt "block description"
msgid "Display the tab list for switching between content panels."
msgstr ""
"Affichez la liste des onglets pour basculer entre les panneaux de contenu."

#: build/blockparty-tabs-panel-item/block.json
msgctxt "block title"
msgid "Panel"
msgstr "Panneau"

#: build/blockparty-tabs-panel-item/block.json
msgctxt "block description"
msgid "The content panel shown when its matching tab is selected."
msgstr ""
"Le panneau de contenu qui s'affiche lorsque l'onglet correspondant est "
"sélectionné."

#: build/blockparty-tabs-panels/block.json
msgctxt "block title"
msgid "Panels"
msgstr "Panneaux"

#: build/blockparty-tabs-panels/block.json
msgctxt "block description"
msgid "Group the content panels of a tabbed interface."
msgstr "Regroupez les panneaux de contenu d'une interface à onglets."

#: build/blockparty-tabs/block.json
msgctxt "block title"
msgid "Tabs"
msgstr "Onglets"

#: build/blockparty-tabs/block.json
msgctxt "block description"
msgid ""
"Organize content into tabs so visitors can browse sections without scrolling "
"endlessly."
msgstr ""

