{
	"extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
	"overrides": [
		{
			"files": [ "tests/js/**/*.js" ],
			"env": {
				"jest": true,
				"browser": true
			},
			"settings": {
				"jsdoc": {
					"tagNamePreference": {
						"jest-environment": "jest-environment"
					}
				}
			},
			"rules": {
				"jsdoc/check-tag-names": [
					"error",
					{
						"definedTags": [ "jest-environment" ]
					}
				]
			}
		},
		{
			"files": [ "tests/playwright/**/*.js" ],
			"rules": {
				"jsdoc/check-tag-names": "off"
			}
		}
	]
}
