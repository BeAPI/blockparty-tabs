{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "blockparty/tabs-panel-item",
	"version": "1.1.5",
	"title": "Panel",
	"category": "widgets",
	"icon": "layout",
	"description": "The content panel shown when its matching tab is selected.",
	"parent": [ "blockparty/tabs-panels" ],
	"supports": {
		"anchor": true,
		"background": {
			"backgroundImage": true,
			"backgroundSize": true,
			"gradient": true
		},
		"html": false,
		"color": {
			"background": true,
			"button": true,
			"heading": true,
			"link": true,
			"text": true
		},
		"layout": true,
		"shadow": true,
		"spacing": {
			"blockGap": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"visibility": false
	},
	"attributes": {
		"linkId": {
			"type": "string"
		},
		"panelId": {
			"type": "string"
		},
		"index": {
			"type": "integer"
		}
	},
	"usesContext": [ "blockparty/Tabs", "blockparty/TabsActive" ],
	"textdomain": "blockparty-tabs",
	"editorScript": "file:./index.js"
}
